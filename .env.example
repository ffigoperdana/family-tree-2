# Copy this file to .env.local for local Docker testing, then replace every CHANGE_ME value.
NODE_ENV=development
PORT=8080
COOKIE_SECURE=0
DATABASE_URL=postgres://soenarto:CHANGE_ME@db:5432/soenarto
SESSION_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_WITH_AT_LEAST_12_CHARACTERS
CANONICAL_TREE_TITLE=Keluarga Haji Soenarto
PUBLIC_APP_ORIGIN=http://127.0.0.1:8080

# Used only by docker-compose.local.yml.
POSTGRES_DB=soenarto
POSTGRES_USER=soenarto
POSTGRES_PASSWORD=CHANGE_ME
APP_BIND_HOST=127.0.0.1
APP_PORT=8080
